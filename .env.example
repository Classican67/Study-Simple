# ---------------------------------------------------------------------------
# 1. Développement local, sans Docker (npm run dev)
# ---------------------------------------------------------------------------
# Les chemins SQLite relatifs sont résolus depuis prisma/, d'où le "../".
DATABASE_URL="file:../data/dev.db"
UPLOAD_DIR="./data/uploads"

# Signe les cookies de session. Générer avec : openssl rand -base64 32
SESSION_SECRET="remplace-moi-par-32-caracteres-aleatoires-au-moins"

# Le cookie de session est marqué Secure en production, donc ignoré en http://.
# En développement local, on le désactive.
COOKIE_SECURE="false"

# Origines autorisées à charger les assets du serveur de DÉVELOPPEMENT.
# Next 16 renvoie 403 sur /_next/static/... et refuse le WebSocket de
# rechargement à chaud pour toute origine autre que localhost.
#
# next.config.ts couvre déjà le LAN en 192.168.x.y et les noms Tailscale
# en .ts.net. Cette variable sert aux cas non couverts : autre plage privée
# (10.x.y.z, 172.16-31.x.y), nom d'hôte mDNS, adresse Tailscale en 100.x.y.z.
# Séparer par des virgules, sans schéma ni port.
#
# ALLOWED_DEV_ORIGINS="10.0.0.12,mon-pc.local"


# ---------------------------------------------------------------------------
# 2. Développement dans Docker (docker-compose.dev.yml)
# ---------------------------------------------------------------------------
# Tout est déjà injecté par le compose : rien à faire ici.
# L'app écoute sur http://localhost:3001


# ---------------------------------------------------------------------------
# 3. Production sur le Xubuntu (docker-compose.yml)
# ---------------------------------------------------------------------------
# Ces variables-là sont lues par le compose de production.

# Port local sur lequel le conteneur est publié. Il n'est PAS exposé au réseau :
# Caddy écoute en 443 et relaie vers ce port.
APP_PORT=3002

# Dossier des images SUR LE NAS, tel que monté sur le Xubuntu.
# Doit exister et être accessible en écriture avant `docker compose up`.
NAS_UPLOADS=/mnt/nas/fiches/uploads

# Dossier des sauvegardes de la base SUR LE NAS. Lu par scripts/backup.sh.
NAS_BACKUPS=/mnt/nas/fiches/backups

# Nom d'hôte servi par Caddy en HTTPS.
FICHES_HOSTNAME=fiches.local

# Mettre "false" UNIQUEMENT pour un accès LAN en http:// sans reverse proxy.
# La PWA n'est alors pas installable (les service workers exigent HTTPS).
COOKIE_SECURE=true
