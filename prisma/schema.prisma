// Clone de Quizlet auto-hébergé : des paquets de cartes (un par cours),
// chaque carte pouvant porter une image à côté du texte de réponse.
// La révision se fait en deux piles : « su » / « à revoir ».

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Comptes
// ---------------------------------------------------------------------------

// Pas d'inscription publique : les comptes sont créés en ligne de commande
// (`npm run user:create`). `role` distingue l'admin, seul autorisé à en créer
// d'autres depuis l'interface.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("user") // "user" | "admin"
  createdAt    DateTime @default(now())

  decks    Deck[]
  folders  Folder[]
  progress CardProgress[]
  sessions StudySession[]
  notes    Note[]
  answers  ReviewAnswer[]
}

// Arborescence de classement. `parentId` nul = dossier à la racine.
// La profondeur n'est pas limitée par le schéma ; l'interface la borne pour
// éviter des fils d'Ariane illisibles.
model Folder {
  id       String  @id @default(cuid())
  ownerId  String
  parentId String?

  /// À quelle section appartient ce dossier : « deck » ou « note ».
  ///
  /// Les deux sections rangeaient leurs affaires dans le même arbre : créer un
  /// dossier pour ses notes en faisait apparaître un dans les paquets. Ce sont
  /// deux classements différents, ils ne se mélangent pas.
  kind String @default("deck")

  name      String
  color     String   @default("slate")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Supprimer un dossier emporte ses sous-dossiers, mais pas les paquets
  // qu'il contient : ceux-ci remontent à la racine (voir Deck.folder).
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  decks    Deck[]
  notes    Note[]

  @@index([ownerId, kind, parentId])
}

// ---------------------------------------------------------------------------
// Contenu
// ---------------------------------------------------------------------------

model Deck {
  id          String   @id @default(cuid())
  ownerId     String
  // Nul = paquet rangé à la racine, hors de tout dossier.
  folderId    String?
  title       String
  description String   @default("")
  // Couleur d'accent du paquet dans la grille, pour les repérer d'un coup d'œil.
  color       String   @default("violet")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // SetNull et non Cascade : jeter un dossier ne doit jamais détruire le
  // travail qu'il contient, seulement le déclasser.
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  cards    Card[]
  tags     DeckTag[]
  sessions StudySession[]

  @@index([ownerId])
  @@index([folderId])
}

// `term` = recto (la question), `definition` = verso (la réponse).
// `imagePath` est le nom de fichier dans UPLOAD_DIR, servi par /api/uploads/<nom>.
// `position` fixe l'ordre d'affichage dans l'éditeur ; la révision, elle, mélange.
model Card {
  id         String   @id @default(cuid())
  deckId     String
  term       String
  definition String
  imagePath  String?
  // Copie normalisée du terme et de la définition — sans accent, sans
  // majuscule, sans balisage — sur laquelle porte la recherche. SQLite ne sait
  // pas retirer les accents en SQL, et Postgres ne le fait qu'avec une
  // extension : stocker la forme comparable rend la recherche portable.
  // Volontairement sans index : une recherche « contient » ne peut pas s'en
  // servir, un index ne ferait qu'alourdir les écritures.
  searchText String   @default("")
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Copie : cette carte a été dupliquée depuis une autre, pour réunir par
  // exemple toutes les figures anatomiques dans un paquet de révision.
  //
  // La copie est **entièrement indépendante** : on la modifie, on la supprime,
  // sans que l'originale en soit affectée — et réciproquement. Ce champ ne
  // sert qu'à deux choses : afficher d'où vient la carte, et éviter de la
  // reprendre deux fois si l'on relance le regroupement.
  //
  // `SetNull` : supprimer l'originale ne doit pas emporter la copie. Elle perd
  // seulement la mention de sa provenance.
  //
  // Attention : les deux cartes partagent le NOM DE FICHIER de leur image.
  // Effacer ce fichier n'est donc permis que lorsque plus aucune carte ne le
  // référence — voir `deleteUnreferencedUploads`.
  sourceCardId String?
  sourceCard   Card?  @relation("CardCopy", fields: [sourceCardId], references: [id], onDelete: SetNull)
  copies       Card[] @relation("CardCopy")

  deck     Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress CardProgress[]
  answers  ReviewAnswer[]

  @@index([deckId, position])
  // Sert à repérer les copies déjà faites, pour ne pas dupliquer deux fois.
  @@index([sourceCardId])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  decks DeckTag[]
}

model DeckTag {
  deckId String
  tagId  String

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([deckId, tagId])
}

// ---------------------------------------------------------------------------
// Progression
// ---------------------------------------------------------------------------

// Un état par (utilisateur, carte) : deux personnes révisant le même paquet
// gardent des progressions distinctes.
//   "new"      — jamais vue
//   "learning" — ratée au moins une fois, revient dans la pile à revoir
//   "known"    — réussie, sort du tas tant qu'on ne réinitialise pas
model CardProgress {
  userId       String
  cardId       String
  status       String    @default("new")
  // Nombre de bonnes réponses d'affilée. Remis à zéro à chaque échec ;
  // c'est la base sur laquelle brancher un jour un vrai calcul de répétition espacée.
  streak       Int       @default(0)
  correctCount Int       @default(0)
  missCount    Int       @default(0)
  lastSeenAt   DateTime?
  // Date à laquelle la carte redevient à réviser. Nulle = jamais répondue,
  // donc à voir tout de suite. Calculée par nextDueAt() à chaque réponse.
  dueAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@index([userId, status])
  // Requête la plus fréquente de l'app : « qu'ai-je à réviser maintenant ? »
  @@index([userId, dueAt])
  // Sert à retrouver le dernier paquet révisé, lu à chaque affichage de
  // l'accueil : sans index, c'est un parcours de toute la progression.
  @@index([userId, lastSeenAt])
}

// Une réponse donnée en révision, telle qu'elle a été donnée.
//
// La progression (`CardProgress`) est un état : rejouer deux fois la même
// réponse dessus compterait deux réussites et allongerait la série à tort. Or
// une réponse donnée hors ligne est **renvoyée** tant que le serveur n'a pas
// confirmé — et une confirmation perdue en route (le réseau coupe pendant la
// réponse) la fait repartir. L'identifiant est donc choisi **par l'appareil**,
// au moment où l'on répond : le serveur reconnaît un envoi déjà reçu et ne
// l'applique qu'une fois.
//
// `answeredAt` est l'heure de la réponse, pas celle de sa réception : une
// carte révisée dans le train mardi est planifiée depuis mardi, même si
// l'iPad ne retrouve le serveur que jeudi.
model ReviewAnswer {
  id         String   @id
  userId     String
  cardId     String
  knew       Boolean
  answeredAt DateTime
  receivedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, answeredAt])
  @@index([cardId])
}

// Une passe de révision terminée, pour afficher un historique et des stats.
model StudySession {
  id           String    @id @default(cuid())
  userId       String
  deckId       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  correctCount Int       @default(0)
  missCount    Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// ---------------------------------------------------------------------------
// Notes
// ---------------------------------------------------------------------------

// Un carnet à côté des cartes : ce qu'on prend en cours, et dont on tirera les
// cartes ensuite. Les notes ne sont pas rangées dans les dossiers de paquets —
// elles ont leur propre espace, pour ne pas mêler deux arborescences.
model Note {
  id        String   @id @default(cuid())
  ownerId   String
  // Les notes se rangent dans la MÊME arborescence que les paquets : un cours
  // a ses cartes et ses notes, deux arbres séparés obligeraient à ranger deux
  // fois. `SetNull` : supprimer un dossier ne doit jamais effacer des notes.
  folderId  String?
  title     String   @default("")
  // Copie normalisée du titre et du texte des blocs, pour la recherche. Même
  // mécanique que `Card.searchText` : SQLite ne sait pas retirer les accents.
  searchText String  @default("")
  // Aperçu de la première page, en JSON compact et borné : soit la page d'un
  // document importé, soit quelques traits échantillonnés.
  //
  // Recalculé à l'enregistrement du bloc concerné, à partir du contenu qu'on
  // a déjà en main — jamais relu pour l'occasion. Une page dense pèse des
  // centaines de kilooctets : la recharger pour afficher une vignette
  // rendrait la liste des notes plus lourde que les notes elles-mêmes.
  preview   String   @default("")
  // « Je maîtrise cette note » : l'appréciation de la personne, jamais un
  // calcul. Rien ne la pose ni ne la retire à sa place.
  mastered  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  blocks NoteBlock[]

  // La liste des notes est triée par date de modification : c'est la note
  // qu'on vient de quitter qu'on rouvre le plus souvent.
  @@index([ownerId, updatedAt])
  @@index([folderId])
}

// Une note est une suite de blocs typés, à la façon d'un document moderne,
// plutôt qu'un seul champ de texte. C'est ce qui permet de mêler un paragraphe,
// un tableau et un croquis dans la même page sans trois éditeurs séparés.
model NoteBlock {
  id       String @id @default(cuid())
  noteId   String
  // "text" | "table" | "drawing"
  kind     String
  position Int    @default(0)
  // Contenu sérialisé en JSON, sa forme dépendant du type de bloc. Du texte
  // pour la base : SQLite comme Postgres le stockent sans extension, et le
  // schéma de chaque bloc reste décrit et validé côté application.
  content  String @default("")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, position])
}
