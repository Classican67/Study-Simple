// Clone de Quizlet auto-hébergé : des paquets de cartes (un par cours),
// chaque carte pouvant porter une image à côté du texte de réponse.
// La révision se fait en deux piles : « su » / « à revoir ».

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Comptes
// ---------------------------------------------------------------------------

// Pas d'inscription publique : les comptes sont créés en ligne de commande
// (`npm run user:create`). `role` distingue l'admin, seul autorisé à en créer
// d'autres depuis l'interface.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("user") // "user" | "admin"
  createdAt    DateTime @default(now())

  decks    Deck[]
  folders  Folder[]
  progress CardProgress[]
  sessions StudySession[]
}

// Arborescence de classement. `parentId` nul = dossier à la racine.
// La profondeur n'est pas limitée par le schéma ; l'interface la borne pour
// éviter des fils d'Ariane illisibles.
model Folder {
  id        String   @id @default(cuid())
  ownerId   String
  parentId  String?
  name      String
  color     String   @default("slate")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Supprimer un dossier emporte ses sous-dossiers, mais pas les paquets
  // qu'il contient : ceux-ci remontent à la racine (voir Deck.folder).
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  decks    Deck[]

  @@index([ownerId, parentId])
}

// ---------------------------------------------------------------------------
// Contenu
// ---------------------------------------------------------------------------

model Deck {
  id          String   @id @default(cuid())
  ownerId     String
  // Nul = paquet rangé à la racine, hors de tout dossier.
  folderId    String?
  title       String
  description String   @default("")
  // Couleur d'accent du paquet dans la grille, pour les repérer d'un coup d'œil.
  color       String   @default("violet")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // SetNull et non Cascade : jeter un dossier ne doit jamais détruire le
  // travail qu'il contient, seulement le déclasser.
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  cards    Card[]
  tags     DeckTag[]
  sessions StudySession[]

  @@index([ownerId])
  @@index([folderId])
}

// `term` = recto (la question), `definition` = verso (la réponse).
// `imagePath` est le nom de fichier dans UPLOAD_DIR, servi par /api/uploads/<nom>.
// `position` fixe l'ordre d'affichage dans l'éditeur ; la révision, elle, mélange.
model Card {
  id         String   @id @default(cuid())
  deckId     String
  term       String
  definition String
  imagePath  String?
  // Copie normalisée du terme et de la définition — sans accent, sans
  // majuscule, sans balisage — sur laquelle porte la recherche. SQLite ne sait
  // pas retirer les accents en SQL, et Postgres ne le fait qu'avec une
  // extension : stocker la forme comparable rend la recherche portable.
  // Volontairement sans index : une recherche « contient » ne peut pas s'en
  // servir, un index ne ferait qu'alourdir les écritures.
  searchText String   @default("")
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deck     Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress CardProgress[]

  @@index([deckId, position])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  decks DeckTag[]
}

model DeckTag {
  deckId String
  tagId  String

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([deckId, tagId])
}

// ---------------------------------------------------------------------------
// Progression
// ---------------------------------------------------------------------------

// Un état par (utilisateur, carte) : deux personnes révisant le même paquet
// gardent des progressions distinctes.
//   "new"      — jamais vue
//   "learning" — ratée au moins une fois, revient dans la pile à revoir
//   "known"    — réussie, sort du tas tant qu'on ne réinitialise pas
model CardProgress {
  userId       String
  cardId       String
  status       String    @default("new")
  // Nombre de bonnes réponses d'affilée. Remis à zéro à chaque échec ;
  // c'est la base sur laquelle brancher un jour un vrai calcul de répétition espacée.
  streak       Int       @default(0)
  correctCount Int       @default(0)
  missCount    Int       @default(0)
  lastSeenAt   DateTime?
  // Date à laquelle la carte redevient à réviser. Nulle = jamais répondue,
  // donc à voir tout de suite. Calculée par nextDueAt() à chaque réponse.
  dueAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@index([userId, status])
  // Requête la plus fréquente de l'app : « qu'ai-je à réviser maintenant ? »
  @@index([userId, dueAt])
}

// Une passe de révision terminée, pour afficher un historique et des stats.
model StudySession {
  id           String    @id @default(cuid())
  userId       String
  deckId       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  correctCount Int       @default(0)
  missCount    Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}
