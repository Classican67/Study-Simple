# Image de développement : le code est bind-monté depuis l'hôte et Next
# recharge tout seul. Aucune source n'est copiée dans l'image.
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Les dépendances sont installées DANS l'image, puis /app/node_modules est
# masqué par un volume anonyme côté compose : les binaires natifs restent ceux
# de Linux et non ceux de l'hôte (macOS ou autre).
COPY package.json package-lock.json ./

# Avant `npm ci`, pour la même raison qu'en production : le `postinstall`
# lance `prisma generate`, qui a besoin du schéma. Il génère donc le client
# au passage, sans qu'une commande séparée soit nécessaire.
COPY prisma ./prisma

RUN npm ci

EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy && npm run dev -- --hostname 0.0.0.0"]
